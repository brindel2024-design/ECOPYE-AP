generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  phone            String   @unique
  fullName         String
  email            String?  @unique
  pin              String
  faceDescriptor   String?  @db.Text
  totpSecret       String?
  totpEnabled      Boolean  @default(false)
  isVerified       Boolean  @default(false)
  isActive         Boolean  @default(true)
  kycStatus        String   @default("pending") // pending, verified, rejected
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  wallet           Wallet?
  sentTransactions     Transaction[] @relation("Sender")
  receivedTransactions Transaction[] @relation("Receiver")
  cagnottes        Cagnotte[]
  contributions    CagnotteContribution[]
  bills            BillPayment[]
  sessions         Session[]

  @@map("users")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(15, 2)
  currency  String   @default("DZD")
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@map("wallets")
}

model Transaction {
  id          String   @id @default(uuid())
  senderId    String
  receiverId  String
  amount      Decimal  @db.Decimal(15, 2)
  currency    String   @default("DZD")
  type        String   // p2p, qr_payment, bill, cagnotte, deposit, withdrawal
  status      String   @default("pending") // pending, completed, failed, cancelled
  reference   String   @unique @default(uuid())
  note        String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sender      User     @relation("Sender", fields: [senderId], references: [id])
  receiver    User     @relation("Receiver", fields: [receiverId], references: [id])

  @@map("transactions")
}

model QRCode {
  id          String   @id @default(uuid())
  merchantId  String
  amount      Decimal? @db.Decimal(15, 2)
  label       String?
  qrData      String   @db.Text
  isStatic    Boolean  @default(false)
  isUsed      Boolean  @default(false)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@map("qr_codes")
}

model BillPayment {
  id          String   @id @default(uuid())
  userId      String
  provider    String   // mobilis, djezzy, ooredoo, sonelgaz, seaal, algerie_telecom
  accountNumber String
  amount      Decimal  @db.Decimal(15, 2)
  status      String   @default("pending")
  reference   String   @unique @default(uuid())
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@map("bill_payments")
}

model Cagnotte {
  id            String   @id @default(uuid())
  creatorId     String
  title         String
  description   String?  @db.Text
  type          String   // charity, family, event
  targetAmount  Decimal? @db.Decimal(15, 2)
  currentAmount Decimal  @default(0) @db.Decimal(15, 2)
  imageUrl      String?
  isPublic      Boolean  @default(true)
  isActive      Boolean  @default(true)
  shareCode     String   @unique
  deadline      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creator       User     @relation(fields: [creatorId], references: [id])
  contributions CagnotteContribution[]

  @@map("cagnottes")
}

model CagnotteContribution {
  id          String   @id @default(uuid())
  cagnotteId  String
  userId      String
  amount      Decimal  @db.Decimal(15, 2)
  message     String?
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())

  cagnotte    Cagnotte @relation(fields: [cagnotteId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@map("cagnotte_contributions")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique @db.Text
  deviceInfo String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model OTPCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  purpose   String   // register, login, transfer, reset
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("otp_codes")
}

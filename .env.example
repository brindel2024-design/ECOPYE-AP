# ============================================================================
# ECOPYE — Environment Variables Template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ---------- Runtime ----------
NODE_ENV=development
LOG_LEVEL=debug

# ---------- API Gateway ----------
API_PORT=3001
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:3001
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# ---------- PostgreSQL 16 ----------
DATABASE_URL=postgresql://ecopye:ecopye_dev@localhost:5432/ecopye?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# ---------- Redis 7 ----------
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# ---------- JWT (RS256) ----------
# Generate with: openssl genrsa -out private.pem 4096 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ISSUER=ecopye.fr
JWT_AUDIENCE=ecopye-app
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- Crypto / KMS ----------
# In production: AWS KMS key ARN. In dev: 32-byte hex string.
AES_ENCRYPTION_KEY=change_me_32_bytes_hex_0123456789abcdef0123456789abcdef
AWS_KMS_KEY_ID=
AWS_REGION=eu-west-3

# ---------- Argon2id ----------
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ---------- OTP / Twilio ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---------- KYC / Onfido ----------
ONFIDO_API_TOKEN=
ONFIDO_WEBHOOK_TOKEN=
ONFIDO_REGION=eu

# ---------- Payment providers ----------
# BEA (Banque Extérieure d'Algérie)
BEA_API_URL=https://api.bea.dz/swift
BEA_CLIENT_ID=
BEA_CLIENT_SECRET=
BEA_MTLS_CERT_PATH=./secrets/bea-client.pem
BEA_MTLS_KEY_PATH=./secrets/bea-client.key

# Sonelgaz / Algérie Télécom / CNAS
SONELGAZ_API_URL=
SONELGAZ_API_KEY=
ALGTEL_API_URL=
ALGTEL_API_KEY=

# Mobile recharges
DJEZZY_API_URL=
DJEZZY_API_KEY=
OOREDOO_API_URL=
OOREDOO_API_KEY=
MOBILIS_API_URL=
MOBILIS_API_KEY=

# ---------- Push notifications ----------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=./secrets/fcm-service-account.json
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=./secrets/apns-auth-key.p8

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=ecopye-api
SENTRY_DSN=
DATADOG_API_KEY=

# ---------- S3 / Document storage ----------
S3_BUCKET_KYC=ecopye-kyc-dev
S3_BUCKET_RECEIPTS=ecopye-receipts-dev
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Compliance ----------
OFAC_SDN_FEED_URL=https://www.treasury.gov/ofac/downloads/sdn.xml
UN_SANCTIONS_FEED_URL=https://scsanctions.un.org/resources/xml/en/consolidated.xml
EU_SANCTIONS_FEED_URL=
WATCHLIST_REFRESH_CRON=0 */6 * * *

# ---------- Web (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development

# ---------- Mobile ----------
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api/v1

# ---------- Rate limiting ----------
RATE_LIMIT_GLOBAL=1000
RATE_LIMIT_AUTH=10
RATE_LIMIT_WINDOW_MS=60000

# ---------- Feature flags ----------
FEATURE_BEA_ENABLED=false
FEATURE_AGENT_NETWORK_ENABLED=false
FEATURE_MERCHANT_ENABLED=true

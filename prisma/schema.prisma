generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KycLevel {
  basic
  verified
  premium
}

enum TransferStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  WALLET
  CIB
  BARIDIMOB
  DAHABIA
}

enum OTPPurpose {
  register
  login
  transfer
  reset
}

enum CagnotteType {
  charity
  family
  event
}

enum BillStatus {
  PENDING
  COMPLETED
  FAILED
}

enum NotificationType {
  transfer_received
  transfer_sent
  bill_paid
  cagnotte
  system
}

enum AuditAction {
  login
  transfer
  bill_payment
  cagnotte_contribution
  face_verify
  pin_verify
}

enum AuditStatus {
  SUCCESS
  FAILED
}

model User {
  id              String    @id @default(cuid())
  phone           String    @unique
  fullName        String
  email           String?   @unique
  passwordHash    String
  pin             String?
  avatar          String?
  isVerified      Boolean   @default(false)
  isActive        Boolean   @default(true)
  faceDescriptor  String?
  faceEnrolledAt  DateTime?
  totpSecret      String?
  totpEnabled     Boolean   @default(false)
  kycLevel        KycLevel  @default(basic)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  wallet                Wallet?
  sentTransfers         Transfer[]             @relation("SentTransfers")
  receivedTransfers     Transfer[]             @relation("ReceivedTransfers")
  payments              Payment[]
  sessions              Session[]
  cagnottes             Cagnotte[]             @relation("CreatedCagnottes")
  cagnotteContribs      CagnotteContribution[] @relation("UserContributions")

  @@map("users")
}

model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  balance     Decimal  @default(0) @db.Decimal(15, 2)
  currency    String   @default("DZD")
  isLocked    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])

  @@map("wallets")
}

model Transfer {
  id          String         @id @default(cuid())
  senderId    String
  receiverId  String
  amount      Decimal        @db.Decimal(15, 2)
  currency    String         @default("DZD")
  description String?
  status      TransferStatus @default(PENDING)
  reference   String         @unique @default(cuid())
  fee         Decimal        @default(0) @db.Decimal(15, 2)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  sender      User           @relation("SentTransfers", fields: [senderId], references: [id])
  receiver    User           @relation("ReceivedTransfers", fields: [receiverId], references: [id])

  @@map("transfers")
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  merchantName  String
  merchantId    String?
  amount        Decimal       @db.Decimal(15, 2)
  currency      String        @default("DZD")
  description   String?
  status        PaymentStatus @default(PENDING)
  reference     String        @unique @default(cuid())
  paymentMethod PaymentMethod @default(WALLET)
  qrCode        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id])

  @@map("payments")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model OTPCode {
  id        String     @id @default(cuid())
  phone     String
  code      String
  purpose   OTPPurpose
  isUsed    Boolean    @default(false)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@map("otp_codes")
}

model QRCode {
  id          String    @id @default(cuid())
  userId      String
  amount      Decimal?  @db.Decimal(15, 2)
  label       String?
  payload     Json
  isStatic    Boolean   @default(false)
  isUsed      Boolean   @default(false)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@map("qr_codes")
}

model Cagnotte {
  id            String       @id @default(cuid())
  creatorId     String
  title         String
  description   String?
  type          CagnotteType @default(charity)
  targetAmount  Decimal?     @db.Decimal(15, 2)
  currentAmount Decimal      @default(0) @db.Decimal(15, 2)
  imageUrl      String?
  isPublic      Boolean      @default(true)
  isActive      Boolean      @default(true)
  shareCode     String       @unique
  deadline      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  creator       User                   @relation("CreatedCagnottes", fields: [creatorId], references: [id])
  contributions CagnotteContribution[]

  @@map("cagnottes")
}

model CagnotteContribution {
  id          String   @id @default(cuid())
  cagnotteId  String
  userId      String
  amount      Decimal  @db.Decimal(15, 2)
  message     String?
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())

  cagnotte    Cagnotte @relation(fields: [cagnotteId], references: [id])
  user        User     @relation("UserContributions", fields: [userId], references: [id])

  @@map("cagnotte_contributions")
}

model BillPayment {
  id            String     @id @default(cuid())
  userId        String
  provider      String
  accountNumber String
  amount        Decimal    @db.Decimal(15, 2)
  status        BillStatus @default(COMPLETED)
  reference     String     @unique @default(cuid())
  paidAt        DateTime   @default(now())

  @@map("bill_payments")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String
  type      NotificationType @default(system)
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  action     AuditAction
  resource   String?
  resourceId String?
  status     AuditStatus @default(SUCCESS)
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@map("audit_logs")
}

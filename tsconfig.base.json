{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@ecopye/types": ["packages/shared/types/src/index.ts"],
      "@ecopye/types/*": ["packages/shared/types/src/*"],
      "@ecopye/config": ["packages/shared/config/src/index.ts"],
      "@ecopye/utils": ["packages/shared/utils/src/index.ts"],
      "@ecopye/constants": ["packages/shared/constants/src/index.ts"],
      "@ecopye/database": ["packages/shared/database/src/index.ts"],
      "@ecopye/ui": ["packages/ui/src/index.ts"],
      "@ecopye/auth-service": ["packages/services/auth-service/src/index.ts"],
      "@ecopye/wallet-service": ["packages/services/wallet-service/src/index.ts"],
      "@ecopye/transaction-service": ["packages/services/transaction-service/src/index.ts"],
      "@ecopye/kyc-service": ["packages/services/kyc-service/src/index.ts"],
      "@ecopye/payment-service": ["packages/services/payment-service/src/index.ts"],
      "@ecopye/notification-service": ["packages/services/notification-service/src/index.ts"],
      "@ecopye/merchant-service": ["packages/services/merchant-service/src/index.ts"],
      "@ecopye/agent-service": ["packages/services/agent-service/src/index.ts"],
      "@ecopye/compliance-service": ["packages/services/compliance-service/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist", ".next"]
}
